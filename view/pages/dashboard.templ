package pages

import (
	"strconv"

	"github.com/nphq/starocean/internal/models"
	"github.com/nphq/starocean/view/vmodel"
	"github.com/nphq/starocean/view/component"
)

// Dashboard 工作台：KPI 磁贴 + CSS 柱状趋势 + 最近订单 + 库存预警。
templ Dashboard(d *models.DashboardData, points []vmodel.MonthPoint) {
	@component.PageHead("工作台", "今日待办、经营数字与库存风险，一张屏看完。") {
		<a href="/sales/new" class="btn-primary">新建销售订单</a>
		<a href="/purchases/new" class="btn-secondary">新建采购单</a>
	}
	<div class="mb-8 grid grid-cols-2 gap-4 lg:grid-cols-4">
		@component.Stat("本月销售额", "¥"+d.MonthSales)
		@component.Stat("待处理订单", strconv.FormatInt(d.PendingOrders, 10))
		@component.Stat("库存预警", strconv.FormatInt(d.LowStockCount, 10))
		@component.Stat("活跃客户", strconv.FormatInt(d.ActiveCustomers, 10))
	</div>
	<div class="mb-8 grid grid-cols-2 gap-4 lg:grid-cols-3">
		@component.Stat("待审批报销", strconv.FormatInt(d.PendingReimbursements, 10))
	</div>
	<div class="card mb-8 p-6 md:p-8">
		<div class="mb-5 flex items-end justify-between gap-3">
			<div>
				<h3 class="text-sm font-semibold text-warm-900 dark:text-warm-100">近 12 个月销售与采购</h3>
				<p class="mt-0.5 text-xs text-warm-400">柱高按期间峰值归一，便于对照进销节奏</p>
			</div>
			<div class="flex gap-4 text-xs text-warm-500">
				<span class="flex items-center gap-1.5"><span class="inline-block h-2 w-2.5 rounded-sm bg-emerald-600"></span>销售</span>
				<span class="flex items-center gap-1.5"><span class="inline-block h-2 w-2.5 rounded-sm bg-brand-600"></span>采购</span>
			</div>
		</div>
		@MonthBars(points)
	</div>
	<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
		<div class="card overflow-hidden lg:col-span-2">
			<div class="flex items-center justify-between border-b border-warm-200 px-5 py-3.5 dark:border-warm-700/60">
				<h3 class="text-sm font-semibold text-warm-900 dark:text-warm-100">最近销售订单</h3>
				<a href="/sales" class="btn-ghost text-xs">全部订单</a>
			</div>
			<table class="w-full">
				<thead>
					<tr>
						<th class="table-header">订单号</th>
						<th class="table-header">客户</th>
						<th class="table-header">日期</th>
						<th class="table-header text-right">金额</th>
						<th class="table-header">状态</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-warm-100 dark:divide-warm-700/60">
					for _, o := range d.RecentOrders {
						<tr class="transition-colors hover:bg-warm-50/50 dark:hover:bg-warm-800/30">
							<td class="table-cell font-medium"><a href={ templ.URL("/sales/" + o.ID.String()) } class="hover:text-brand-600">{ o.OrderNo }</a></td>
							<td class="table-cell text-warm-600 dark:text-warm-400">{ orDash(o.CustomerName) }</td>
							<td class="table-cell text-warm-500">{ vmodel.DateOnly(o.OrderDate) }</td>
							<td class="table-cell text-right font-semibold tnum">{ vmodel.Money(o.TotalAmount) }</td>
							<td class="table-cell"><span class={ "badge", vmodel.StatusClass(o.Status) }>{ vmodel.StatusLabel(o.Status) }</span></td>
						</tr>
					}
					if len(d.RecentOrders) == 0 {
						<tr><td colspan="5" class="table-cell py-10 text-center text-warm-400">暂无近期订单</td></tr>
					}
				</tbody>
			</table>
		</div>
		<div class="card flex flex-col overflow-hidden">
			<div class="border-b border-warm-200 px-5 py-3.5 dark:border-warm-700/60">
				<h3 class="text-sm font-semibold text-warm-900 dark:text-warm-100">库存预警</h3>
			</div>
			<div class="flex-1 space-y-3 overflow-y-auto p-5">
				for _, p := range d.LowStockItems {
					<a href={ templ.URL("/inventory/" + p.ID.String()) } class="flex items-center gap-3 rounded-lg border border-rose-100 bg-rose-50/50 p-3 transition-colors hover:border-rose-300 dark:border-rose-900/40 dark:bg-rose-950/20">
						<div class="min-w-0 flex-1">
							<h4 class="truncate text-sm font-semibold text-warm-900 dark:text-warm-100">{ p.Name }</h4>
							<p class="tnum mt-0.5 text-xs text-warm-500">当前 <span class="font-bold text-rose-500">{ strconv.Itoa(int(p.CurrentStock)) }</span> / 安全线 { strconv.Itoa(int(p.SafetyStock)) }</p>
						</div>
					</a>
				}
				if len(d.LowStockItems) == 0 {
					<p class="py-10 text-center text-sm text-warm-400">库存一切正常</p>
				}
			</div>
		</div>
	</div>
}

func orDash(s string) string {
	if s == "" {
		return "—"
	}
	return s
}

// MonthBars 纯 CSS 双柱状图。
templ MonthBars(points []vmodel.MonthPoint) {
	<div class="flex h-44 items-end gap-2" role="img" aria-label="近12个月销售与采购趋势">
		for _, p := range points {
			<div class="flex min-w-0 flex-1 flex-col items-center gap-1" title={ p.Label + " 销售¥" + strconv.FormatFloat(p.Sales, 'f', 2, 64) + " 采购¥" + strconv.FormatFloat(p.Purchases, 'f', 2, 64) }>
				<div class="flex h-36 w-full items-end justify-center gap-0.5">
					<div class="w-[45%] max-w-3 rounded-t-sm bg-emerald-600/90" style={ "height:" + pct(p.Sales, chartPeak(points)) }></div>
					<div class="w-[45%] max-w-3 rounded-t-sm bg-brand-600/90" style={ "height:" + pct(p.Purchases, chartPeak(points)) }></div>
				</div>
				<span class="text-[10px] text-warm-400">{ shortMonth(p.Label) }</span>
			</div>
		}
	</div>
}

func chartPeak(points []vmodel.MonthPoint) float64 {
	peak := 1.0
	for _, p := range points {
		if p.Sales > peak {
			peak = p.Sales
		}
		if p.Purchases > peak {
			peak = p.Purchases
		}
	}
	return peak
}

func pct(v, peak float64) string {
	if peak <= 0 {
		return "2%"
	}
	p := v / peak * 100
	if p < 2 && v > 0 {
		p = 2
	}
	return strconv.FormatFloat(p, 'f', 1, 64) + "%"
}

func shortMonth(label string) string {
	if len(label) > 5 {
		return label[5:]
	}
	return label
}
