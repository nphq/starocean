package component

import "strconv"

// PageHead 对象页头（Fiori Object Page：标题、说明、右侧操作）。
templ PageHead(title, subtitle string) {
	<div class="mb-8 flex flex-col justify-between gap-4 md:flex-row md:items-end dark:border-warm-700/60">
		<div class="min-w-0">
			<h1 class="text-[1.65rem] font-semibold leading-tight tracking-tight text-warm-900 dark:text-warm-50">{ title }</h1>
			if subtitle != "" {
				<p class="mt-1.5 max-w-2xl text-sm leading-relaxed text-warm-500 dark:text-warm-400">{ subtitle }</p>
			}
		</div>
		<div class="flex flex-shrink-0 flex-wrap items-center gap-2">
			{ children... }
		</div>
	</div>
}

// Alert 行内错误/提示条。
templ Alert(msg string) {
	if msg != "" {
		<div class="mb-4 flex items-start gap-2.5 rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700 dark:border-rose-800/50 dark:bg-rose-950/30 dark:text-rose-300" role="alert">
			<svg class="mt-0.5 h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z"></path></svg>
			{ msg }
		</div>
	}
}

// Empty 空状态。
templ Empty(message, hint, actionHref, actionLabel string) {
	<div class="px-6 py-16 text-center">
		<div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-warm-100 text-warm-400 dark:bg-warm-800">
			<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 0 1 0 3.75H5.625a1.875 1.875 0 0 1 0-3.75Z"></path></svg>
		</div>
		<p class="text-sm font-semibold text-warm-700 dark:text-warm-200">{ message }</p>
		if hint != "" {
			<p class="mt-1 text-xs text-warm-400">{ hint }</p>
		}
		if actionHref != "" {
			<a href={ templ.URL(actionHref) } class="btn-primary mt-5 !px-4 !py-2 text-xs">{ actionLabel }</a>
		}
	</div>
}

// Pagination 简单分页（htmx：只替换 #list 区域，不整页刷新）。
templ Pagination(base string, page int32, total int64, pageSize int) {
	if total > int64(pageSize) {
		<div class="flex flex-col justify-between gap-3 border-t border-warm-200 bg-warm-50/80 px-4 py-3 sm:flex-row sm:items-center md:px-6 dark:border-warm-700/40 dark:bg-warm-900/40">
			<p class="tnum text-xs text-warm-500">共 { strconv.FormatInt(total, 10) } 条 · 第 { strconv.Itoa(int(page)) } / { strconv.Itoa(totalPages(total, pageSize)) } 页</p>
			<nav aria-label="分页" class="flex items-center gap-1.5">
				if page > 1 {
					<a href={ templ.URL(pageURL(base, int(page)-1)) } hx-get={ pageURL(base, int(page)-1) } hx-target="#list" hx-swap="innerHTML" hx-push-url="true" class="btn-secondary !px-3 !py-1.5 text-xs">上一页</a>
				}
				if int(page) < totalPages(total, pageSize) {
					<a href={ templ.URL(pageURL(base, int(page)+1)) } hx-get={ pageURL(base, int(page)+1) } hx-target="#list" hx-swap="innerHTML" hx-push-url="true" class="btn-secondary !px-3 !py-1.5 text-xs">下一页</a>
				}
			</nav>
		</div>
	}
}

func totalPages(total int64, pageSize int) int {
	return int((total + int64(pageSize) - 1) / int64(pageSize))
}

func pageURL(base string, p int) string {
	sep := "?"
	for i := 0; i < len(base); i++ {
		if base[i] == '?' {
			sep = "&"
			break
		}
	}
	return base + sep + "page=" + strconv.Itoa(p)
}

// Stat 仪表盘 KPI 磁贴（Fiori tile：左侧色条 + 大数字）。
templ Stat(label, value string) {
	<div class="kpi-tile">
		<p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.12em] text-warm-500 dark:text-warm-400">{ label }</p>
		<p class="tnum text-[1.85rem] font-semibold tracking-tight text-warm-900 dark:text-warm-50">{ value }</p>
	</div>
}

// DlRow 详情定义行。
templ DlRow(term, desc string) {
	<div class="flex justify-between gap-4 border-b border-warm-100 px-4 py-2.5 last:border-0 dark:border-warm-700/40">
		<dt class="flex-shrink-0 text-sm text-warm-500">{ term }</dt>
		<dd class="text-right text-sm font-medium text-warm-900 dark:text-warm-100">{ desc }</dd>
	</div>
}

// Field 表单字段。
templ Field(name, label, value, inputType, placeholder string, required bool) {
	<label class="block">
		<span class="mb-1.5 block text-xs font-semibold text-warm-600 dark:text-warm-400">
			{ label }
			if required {
				<span class="text-rose-500">*</span>
			}
		</span>
		<input type={ inputType } name={ name } value={ value } placeholder={ placeholder } required?={ required } class="input-field"/>
	</label>
}

// TextArea 多行文本字段。
templ TextArea(name, label, value, placeholder string) {
	<label class="block">
		<span class="mb-1.5 block text-xs font-semibold text-warm-600 dark:text-warm-400">{ label }</span>
		<textarea name={ name } placeholder={ placeholder } rows="3" class="input-field">{ value }</textarea>
	</label>
}
