package layout

// NavItem 侧栏导航项；Group 为空表示顶级直链。
type NavItem struct {
	Href  string
	Label string
}

// NavGroup 侧栏分组（<details> 手风琴，零 JS）。
type NavGroup struct {
	Label string
	Items []NavItem
}

// AppNav 侧栏导航 IA。
func AppNav() []NavGroup {
	return []NavGroup{
		{Label: "业务管理", Items: []NavItem{
			{Href: "/", Label: "仪表盘"},
			{Href: "/sales", Label: "销售订单"},
			{Href: "/purchases", Label: "采购入库"},
			{Href: "/workreports", Label: "工作报告"},
			{Href: "/attendance", Label: "考勤打卡"},
		}},
		{Label: "基础档案", Items: []NavItem{
			{Href: "/products", Label: "商品资料"},
			{Href: "/customers", Label: "客户管理"},
			{Href: "/suppliers", Label: "供应商"},
		}},
		{Label: "库存与财务", Items: []NavItem{
			{Href: "/inventory", Label: "库存变动"},
			{Href: "/finance", Label: "收付流水"},
			{Href: "/finance/reimbursements", Label: "费用报销"},
			{Href: "/finance/invoices", Label: "发票管理"},
			{Href: "/finance/reconciliations", Label: "对账管理"},
		}},
		{Label: "总账会计", Items: []NavItem{
			{Href: "/ledger", Label: "结账"},
			{Href: "/ledger/vouchers", Label: "会计凭证"},
			{Href: "/ledger/accounts", Label: "会计科目"},
			{Href: "/ledger/books", Label: "账簿"},
			{Href: "/ledger/reports", Label: "财务报表"},
		}},
		{Label: "人事管理", Items: []NavItem{
			{Href: "/personnel/employees", Label: "员工档案"},
			{Href: "/personnel/salary", Label: "薪资管理"},
			{Href: "/personnel/contracts", Label: "劳动合同"},
			{Href: "/personnel/departments", Label: "组织架构"},
		}},
		{Label: "仓储", Items: []NavItem{
			{Href: "/picking", Label: "分拣"},
		}},
	}
}

// activeGroup 当前路径所在分组（默认展开）。
func activeGroup(path string) string {
	for _, g := range AppNav() {
		for _, it := range g.Items {
			if it.Href == "/" {
				if path == "/" {
					return g.Label
				}
				continue
			}
			if path == it.Href || len(path) > len(it.Href) && path[:len(it.Href)] == it.Href && path[len(it.Href)] == '/' {
				return g.Label
			}
		}
	}
	return ""
}

func isActive(path, href string) bool {
	if href == "/" {
		return path == "/"
	}
	return path == href || len(path) > len(href) && path[:len(href)] == href && path[len(href)] == '/'
}

templ Base(title, active, companyName, username, role string) {
	<!DOCTYPE html>
	<html lang="zh-CN">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } · { companyName }</title>
			<link rel="icon" type="image/png" href="/static/icon.png"/>
			<link rel="stylesheet" href="/static/css/output.css"/>
			<script src="/static/js/htmx.min.js" defer></script>
			<script>
				// 深色模式（localStorage，与旧 SPA 同键名，无缝迁移偏好）
				try {
					var d = localStorage.getItem('darkMode');
					if (d === 'true' || (!d && matchMedia('(prefers-color-scheme: dark)').matches)) {
						document.documentElement.classList.add('dark');
					}
				} catch (e) {}
			</script>
		</head>
		<body class="bg-warm-50 text-warm-900 dark:bg-warm-900 dark:text-warm-100">
			<div class="flex h-screen overflow-hidden">
				<aside class="hidden w-60 flex-shrink-0 flex-col border-r border-warm-200 bg-white md:flex dark:border-warm-700/60 dark:bg-warm-800">
					<div class="flex h-16 items-center border-b border-warm-200 px-5 dark:border-warm-700/60">
						<a href="/" class="flex items-center" title={ companyName }>
							<img src="/static/icon.png" alt={ companyName } width="40" height="40" class="h-10 w-10 flex-shrink-0 rounded-lg shadow-sm"/>
						</a>
					</div>
					<nav class="scroll-thin flex-1 space-y-1 overflow-y-auto px-3 py-4">
						for _, g := range AppNav() {
							<details open={ activeGroup(active) == g.Label } class="group">
								<summary class="flex w-full cursor-pointer list-none items-center justify-between px-3 pb-2 pt-1 [&::-webkit-details-marker]:hidden">
									<span class="text-[10px] font-semibold uppercase tracking-widest text-warm-400 dark:text-warm-500">{ g.Label }</span>
									<svg class="h-3.5 w-3.5 text-warm-300 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"></path></svg>
								</summary>
								for _, it := range g.Items {
									<a href={ templ.URL(it.Href) } class={ "mb-0.5", templ.KV("nav-link-active", isActive(active, it.Href)), templ.KV("nav-link", !isActive(active, it.Href)) }>{ it.Label }</a>
								}
							</details>
						}
					</nav>
					<div class="border-t border-warm-200 bg-warm-50/50 p-4 dark:border-warm-700/60 dark:bg-warm-800/50">
						<div class="flex items-center justify-between">
							<button
								type="button"
								onclick="try{var d=document.documentElement.classList.toggle('dark');localStorage.setItem('darkMode',String(d))}catch(e){}"
								class="flex h-9 w-9 items-center justify-center rounded-lg text-warm-400 transition-colors hover:bg-warm-100 hover:text-warm-600 dark:hover:bg-warm-700 dark:hover:text-warm-300"
								title="切换深色模式"
							>◐</button>
							<span class="text-xs font-medium text-warm-500 dark:text-warm-400">{ username }</span>
							if role == "viewer" {
								<span class="badge bg-warm-100 text-warm-500 border border-warm-200">只读</span>
							}
							<a href="/logout" class="flex h-9 w-9 items-center justify-center rounded-lg text-warm-400 transition-colors hover:bg-rose-50 hover:text-rose-500 dark:hover:bg-rose-950/30" title="退出登录">⎋</a>
						</div>
					</div>
				</aside>
				<div class="flex h-full min-w-0 flex-1 flex-col overflow-hidden">
					<header class="sticky top-0 z-30 flex h-16 flex-shrink-0 items-center justify-between border-b border-warm-200 bg-white/80 px-4 backdrop-blur-md md:px-8 dark:border-warm-700/60 dark:bg-warm-800/80">
						<nav aria-label="面包屑" class="flex min-w-0 items-center gap-1.5 text-sm">
							<a href="/" class="flex-shrink-0 text-warm-400 hover:text-brand-600" title="仪表盘">⌂</a>
							<span class="flex-shrink-0 text-warm-300">/</span>
							<span class="truncate font-medium text-warm-900 dark:text-warm-100">{ title }</span>
						</nav>
						<form action="/search" method="get" class="flex w-52 items-center gap-2 rounded-md border border-warm-300 bg-warm-50 px-3 py-1.5 text-sm text-warm-400 md:w-72 dark:border-warm-700 dark:bg-warm-800/50">
							<span>⌕</span>
							<input type="search" name="q" placeholder="搜索单据、商品、客户…" class="w-full bg-transparent text-warm-900 outline-none placeholder:text-warm-400 dark:text-warm-100"/>
						</form>
					</header>
					<main class="scroll-thin flex-1 overflow-y-auto">
						<div class="mx-auto max-w-[1440px] p-4 md:p-8">
							{ children... }
						</div>
					</main>
				</div>
			</div>
		</body>
	</html>
}
